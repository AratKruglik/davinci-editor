 "transcription": {
  "language": "uk",
  "segments": [
   {
    "start": "14:11:42:12",
    "end": "14:11:47:24",
    "text": "Назву мережі краще зробити без імені та прізвища, щоб сусіди не знали, чия вона.",
    "speaker": null,
    "words": [
     {
      "start": "14:11:42:12",
      "end": "14:11:42:21",
      "text": "Назву"
     },
     {
      "start": "14:11:42:23",
      "end": "14:11:43:07",
      "text": "мережі"
     },
     {
      "start": "14:11:43:09",
      "end": "14:11:43:17",
      "text": "краще"
     },
     {
      "start": "14:11:43:19",
      "end": "14:11:44:05",
      "text": "зробити"
     },
     {
      "start": "14:11:44:06",
      "end": "14:11:44:13",
      "text": "без"
     },
     {
      "start": "14:11:44:14",
      "end": "14:11:44:23",
      "text": "імені"
     },
     {
      "start": "14:11:44:24",
      "end": "14:11:45:05",
      "text": "та"
     },
     {
      "start": "14:11:45:06",
      "end": "14:11:45:19",
      "text": "прізвища,"
     },
     {
      "start": "14:11:45:21",
      "end": "14:11:46:02",
      "text": "щоб"
     },
     {
      "start": "14:11:46:04",
      "end": "14:11:46:13",
      "text": "сусіди"
     },
     {
      "start": "14:11:46:15",
      "end": "14:11:46:20",
      "text": "не"
     },
     {
      "start": "14:11:46:22",
      "end": "14:11:47:06",
      "text": "знали,"
     },
     {
      "start": "14:11:47:08",
      "end": "14:11:47:14",
      "text": "чия"
     },
     {
      "start": "14:11:47:16",
      "end": "14:11:47:24",
      "text": "вона."
     }
    ]
   },
   {
    "start": "14:11:47:18",
    "end": "14:11:51:02",
    "text": "Пароль має бути не коротшим за дванадцять символів.",
    "speaker": null,
    "words": [
     {
      "start": "14:11:47:18",
      "end": "14:11:48:03",
      "text": "Пароль"
     },
     {
      "start": "14:11:48:04",
      "end": "14:11:48:11",
      "text": "має"
     },
     {
      "start": "14:11:48:12",
      "end": "14:11:48:20",
      "text": "бути"
     },
     {
      "start": "14:11:48:21",
      "end": "14:11:49:02",
      "text": "не"
     },
     {
      "start": "14:11:49:03",
      "end": "14:11:49:15",
      "text": "коротшим"
     },
     {
      "start": "14:11:49:17",
      "end": "14:11:49:22",
      "text": "за"
     },
     {
      "start": "14:11:49:23",
      "end": "14:11:50:13",
      "text": "дванадцять"
     },
     {
      "start": "14:11:50:14",
      "end": "14:11:51:02",
      "text": "символів."
     }
    ]
   },
   {
    "start": "14:11:51:11",
    "end": "14:11:55:04",
    "text": "Ось головна помилка, яку роблять дев'ять людей з десяти.",
    "speaker": null,
    "words": [
     {
      "start": "14:11:51:11",
      "end": "14:11:51:17",
      "text": "Ось"
     },
     {
      "start": "14:11:51:19",
      "end": "14:11:52:05",
      "text": "головна"
     },
     {
      "start": "14:11:52:06",
      "end": "14:11:52:18",
      "text": "помилка,"
     },
     {
      "start": "14:11:52:20",
      "end": "14:11:53:01",
      "text": "яку"
     },
     {
      "start": "14:11:53:03",
      "end": "14:11:53:13",
      "text": "роблять"
     },
     {
      "start": "14:11:53:15",
      "end": "14:11:54:01",
      "text": "дев'ять"
     },
     {
      "start": "14:11:54:02",
      "end": "14:11:54:11",
      "text": "людей"
     },
     {
      "start": "14:11:54:12",
      "end": "14:11:54:16",
      "text": "з"
     },
     {
      "start": "14:11:54:18",
      "end": "14:11:55:04",
      "text": "десяти."
     }
    ]
   },
   {
    "start": "14:11:55:13",
    "end": "14:12:00:05",
    "text": "Вони залишають стандартний пароль адміністратора, той самий, що на наліпці.",
    "speaker": null,
    "words": [
     {
      "start": "14:11:55:13",
      "end": "14:11:55:20",
      "text": "Вони"
     },
     {
      "start": "14:11:55:22",
      "end": "14:11:56:10",
      "text": "залишають"
     },
     {
      "start": "14:11:56:11",
      "end": "14:11:57:02",
      "text": "стандартний"
     },
     {
      "start": "14:11:57:03",
      "end": "14:11:57:13",
      "text": "пароль"
     },
     {
      "start": "14:11:57:14",
      "end": "14:11:58:09",
      "text": "адміністратора,"
     },
     {
      "start": "14:11:58:11",
      "end": "14:11:58:17",
      "text": "той"
     },
     {
      "start": "14:11:58:19",
      "end": "14:11:59:03",
      "text": "самий,"
     },
     {
      "start": "14:11:59:05",
      "end": "14:11:59:10",
      "text": "що"
     },
     {
      "start": "14:11:59:12",
      "end": "14:11:59:17",
      "text": "на"
     },
     {
      "start": "14:11:59:18",
      "end": "14:12:00:05",
      "text": "наліпці."
     }
    ]
   },
   {
    "start": "14:12:00:14",
    "end": "14:12:07:08",
    "text": "Цей пароль однаковий у тисяч роутерів цієї моделі, і списки таких паролів лежать у відкритому доступі.",
    "speaker": null,
    "words": [
     {
      "start": "14:12:00:14",
      "end": "14:12:00:20",
      "text": "Цей"
     },
     {
      "start": "14:12:00:22",
      "end": "14:12:01:07",
      "text": "пароль"
     },
     {
      "start": "14:12:01:08",
      "end": "14:12:01:21",
      "text": "однаковий"
     },
     {
      "start": "14:12:01:23",
      "end": "14:12:02:02",
      "text": "у"
     },
     {
      "start": "14:12:02:04",
      "end": "14:12:02:12",
      "text": "тисяч"
     },
     {
      "start": "14:12:02:14",
      "end": "14:12:03:01",
      "text": "роутерів"
     },
     {
      "start": "14:12:03:02",
      "end": "14:12:03:10",
      "text": "цієї"
     },
     {
      "start": "14:12:03:11",
      "end": "14:12:03:22",
      "text": "моделі,"
     },
     {
      "start": "14:12:03:23",
      "end": "14:12:04:03",
      "text": "і"
     },
     {
      "start": "14:12:04:04",
      "end": "14:12:04:14",
      "text": "списки"
     },
     {
      "start": "14:12:04:15",
      "end": "14:12:04:24",
      "text": "таких"
     },
     {
      "start": "14:12:05:01",
      "end": "14:12:05:11",
      "text": "паролів"
     },
     {
      "start": "14:12:05:13",
      "end": "14:12:05:23",
      "text": "лежать"
     },
     {
      "start": "14:12:05:24",
      "end": "14:12:06:03",
      "text": "у"
     },
     {
      "start": "14:12:06:05",
      "end": "14:12:06:19",
      "text": "відкритому"
     },
     {
      "start": "14:12:06:21",
      "end": "14:12:07:08",
      "text": "доступі."
     }
    ]
   },
   {
    "start": "14:12:07:16",
    "end": "14:12:12:18",
    "text": "Тобто зловмисник з сусідньої квартири зайде в налаштування буквально за хвилину.",
    "speaker": null,
    "words": [
     {
      "start": "14:12:07:16",
      "end": "14:12:08:00",
      "text": "Тобто"
     },
     {
      "start": "14:12:08:01",
      "end": "14:12:08:16",
      "text": "зловмисник"
     },
     {
      "start": "14:12:08:17",
      "end": "14:12:08:21",
      "text": "з"
     },
     {
      "start": "14:12:08:23",
      "end": "14:12:09:11",
      "text": "сусідньої"
     },
     {
      "start": "14:12:09:12",
      "end": "14:12:09:24",
      "text": "квартири"
     },
     {
      "start": "14:12:10:01",
      "end": "14:12:10:10",
      "text": "зайде"
     },
     {
      "start": "14:12:10:11",
      "end": "14:12:10:15",
      "text": "в"
     },
     {
      "start": "14:12:10:17",
      "end": "14:12:11:08",
      "text": "налаштування"
     },
     {
      "start": "14:12:11:10",
      "end": "14:12:11:23",
      "text": "буквально"
     },
     {
      "start": "14:12:11:24",
      "end": "14:12:12:05",
      "text": "за"
     },
     {
      "start": "14:12:12:06",
      "end": "14:12:12:18",
      "text": "хвилину."
     }
    ]
   },
   {
    "start": "14:12:13:02",
    "end": "14:12:17:15",
    "text": "Він може змінити адресу DNS і непомітно підмінити сайт вашого банку.",
    "speaker": null,
    "words": [
     {
      "start": "14:12:13:02",
      "end": "14:12:13:08",
      "text": "Він"
     },
     {
      "start": "14:12:13:10",
      "end": "14:12:13:17",
      "text": "може"
     },
     {
      "start": "14:12:13:19",
      "end": "14:12:14:05",
      "text": "змінити"
     },
     {
      "start": "14:12:14:06",
      "end": "14:12:14:16",
      "text": "адресу"
     },
     {
      "start": "14:12:14:17",
      "end": "14:12:14:24",
      "text": "DNS"
     },
     {
      "start": "14:12:15:00",
      "end": "14:12:15:04",
      "text": "і"
     },
     {
      "start": "14:12:15:06",
      "end": "14:12:15:19",
      "text": "непомітно"
     },
     {
      "start": "14:12:15:20",
      "end": "14:12:16:09",
      "text": "підмінити"
     },
     {
      "start": "14:12:16:10",
      "end": "14:12:16:18",
      "text": "сайт"
     },
     {
      "start": "14:12:16:19",
      "end": "14:12:17:04",
      "text": "вашого"
     },
     {
      "start": "14:12:17:05",
      "end": "14:12:17:15",
      "text": "банку."
     }
    ]
   },
   {
    "start": "14:12:17:24",
    "end": "14:12:21:18",
    "text": "Тому одразу змініть пароль адміністратора в розділі система.",
    "speaker": null,
    "words": [
     {
      "start": "14:12:17:24",
      "end": "14:12:18:06",
      "text": "Тому"
     },
     {
      "start": "14:12:18:08",
      "end": "14:12:18:18",
      "text": "одразу"
     },
     {
      "start": "14:12:18:19",
      "end": "14:12:19:05",
      "text": "змініть"
     },
     {
      "start": "14:12:19:06",
      "end": "14:12:19:16",
      "text": "пароль"
     },
     {
      "start": "14:12:19:18",
      "end": "14:12:20:11",
      "text": "адміністратора"
     },
     {
      "start": "14:12:20:13",
      "end": "14:12:20:17",
      "text": "в"
     },
     {
      "start": "14:12:20:19",
      "end": "14:12:21:04",
      "text": "розділі"
     },
     {
      "start": "14:12:21:06",
      "end": "14:12:21:18",
      "text": "система."
     }
    ]
   },
   {
    "start": "14:12:22:02",
    "end": "14:12:27:06",
    "text": "Зробіть його довгим, а не складним: три-чотири випадкові слова підійдуть ідеально.",
    "speaker": null,
    "words": [
     {
      "start": "14:12:22:02",
      "end": "14:12:22:13",
      "text": "Зробіть"
     },
     {
      "start": "14:12:22:14",
      "end": "14:12:22:22",
      "text": "його"
     },
     {
      "start": "14:12:22:23",
      "end": "14:12:23:09",
      "text": "довгим,"
     },
     {
      "start": "14:12:23:10",
      "end": "14:12:23:15",
      "text": "а"
     },
     {
      "start": "14:12:23:16",
      "end": "14:12:23:21",
      "text": "не"
     },
     {
      "start": "14:12:23:23",
      "end": "14:12:24:11",
      "text": "складним:"
     },
     {
      "start": "14:12:24:12",
      "end": "14:12:25:02",
      "text": "три-чотири"
     },
     {
      "start": "14:12:25:03",
      "end": "14:12:25:16",
      "text": "випадкові"
     },
     {
      "start": "14:12:25:18",
      "end": "14:12:26:01",
      "text": "слова"
     },
     {
      "start": "14:12:26:03",
      "end": "14:12:26:16",
      "text": "підійдуть"
     },
     {
      "start": "14:12:26:18",
      "end": "14:12:27:06",
      "text": "ідеально."
     }
    ]
   },
   {
    "start": "14:12:27:14",
    "end": "14:12:31:10",
    "text": "І ось результат: мережа працює, а швидкість зросла вдвічі.",
    "speaker": null,
    "words": [
     {
      "start": "14:12:27:14",
      "end": "14:12:27:19",
      "text": "І"
     },
     {
      "start": "14:12:27:20",
      "end": "14:12:28:01",
      "text": "ось"
     },
     {
      "start": "14:12:28:03",
      "end": "14:12:28:17",
      "text": "результат:"
     },
     {
      "start": "14:12:28:19",
      "end": "14:12:29:03",
      "text": "мережа"
     },
     {
      "start": "14:12:29:05",
      "end": "14:12:29:16",
      "text": "працює,"
     },
     {
      "start": "14:12:29:17",
      "end": "14:12:29:21",
      "text": "а"
     },
     {
      "start": "14:12:29:23",
      "end": "14:12:30:11",
      "text": "швидкість"
     },
     {
      "start": "14:12:30:13",
      "end": "14:12:30:22",
      "text": "зросла"
     },
     {
      "start": "14:12:30:24",
      "end": "14:12:31:10",
      "text": "вдвічі."
     }
    ]
   },
   {
    "start": "14:12:31:18",
    "end": "14:12:34:20",
    "text": "Якщо відео було корисним, підпишіться на канал.",
    "speaker": null,
    "words": [
     {
      "start": "14:12:31:18",
      "end": "14:12:32:01",
      "text": "Якщо"
     },
     {
      "start": "14:12:32:02",
      "end": "14:12:32:11",
      "text": "відео"
     },
     {
      "start": "14:12:32:13",
      "end": "14:12:32:20",
      "text": "було"
     },
     {
      "start": "14:12:32:22",
      "end": "14:12:33:10",
      "text": "корисним,"
     },
     {
      "start": "14:12:33:11",
      "end": "14:12:34:02",
      "text": "підпишіться"
     },
     {
      "start": "14:12:34:03",
      "end": "14:12:34:08",
      "text": "на"
     },
     {
      "start": "14:12:34:10",
      "end": "14:12:34:20",
      "text": "канал."
     }
    ]
   },
   {
    "start": "14:12:35:03",
    "end": "14:12:35:15",
    "text": "Бувайте.",
    "speaker": null,
    "words": [
     {
      "start": "14:12:35:03",
      "end": "14:12:35:15",
      "text": "Бувайте."
     }
    ]
   }
  ]
 }
}